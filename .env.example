# Скопируйте в .env и при необходимости измените значения.
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions
LM_STUDIO_MODEL=qwen/qwen2.5-coder-14b
LM_STUDIO_TIMEOUT=900

# Модель Whisper: tiny, base, small, medium
WHISPER_MODEL=small
WHISPER_LANGUAGE=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# 1 — включить VAD (отсечение тишины); на части систем роняет процесс
WHISPER_VAD=0

# Интервал между кадрами (секунды)
FRAME_INTERVAL=5

# Путь к tesseract.exe, если он не в PATH
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
